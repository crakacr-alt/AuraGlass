<resources>
    <style name="AuraTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#BBA6E9</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#171B31</item>
        <item name="android:navigationBarColor">#111325</item>
        <item name="android:windowBackground">#111325</item>
    </style>
    <style name="AuraHomeTheme" parent="@style/AuraTheme">
        <item name="android:windowShowWallpaper">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
